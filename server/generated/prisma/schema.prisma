generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model admin {
  id        String  @id @default(uuid())
  firstname String
  lastname  String
  email     String  @unique(map: "Admin_email_key")
  password  String
  isactive  Boolean @default(true)
}

model buyer {
  firstname String
  lastname  String
  email     String  @unique(map: "Buyer_email_key")
  password  String
  phone     String  @db.VarChar(20)
  isactive  Boolean @default(true)
  id        String  @id @default(uuid())
}

model farmer {
  firstname String
  lastname  String
  email     String    @unique(map: "Farmer_email_key")
  password  String
  phone     String    @db.VarChar(20)
  isactive  Boolean   @default(true)
  id        String    @id @default(uuid())
  order     myorder[]
  product   product[]
}

model myorder {
  id                String               @id @default(uuid())
  customertype      order_customertype
  productid         String
  deliverylatitude  Float?
  deliverylongitude Float?
  deliveryoption    order_deliveryoption @default(FARMER)
  totalcost         Float
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  tracking          order_tracking       @default(PACKING)
  farmerid          String
  userId            String
  quantity          Int
  farmer            farmer               @relation(fields: [farmerid], references: [id], map: "Order_farmerid_fkey")
  product           product              @relation(fields: [productid], references: [id], map: "Order_productid_fkey")
  user              user                 @relation(fields: [userId], references: [id], map: "Order_userId_fkey")

  @@index([farmerid], map: "Order_farmerid_fkey")
  @@index([productid], map: "Order_productid_fkey")
  @@index([userId], map: "Order_userId_fkey")
}

model product {
  id                String         @id @default(uuid())
  name              String
  type              product_type
  unit              product_unit
  priceperunit      Int
  quantity          Int
  variety           String
  perishdate        DateTime
  location          String
  status            product_status
  description       String
  images            Json
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  farmerid          String
  discount          Int            @default(0)
  locationlatitude  Float          @default(0)
  locationlongitude Float          @default(0)
  supplierthreshold Int            @default(0)
  farmerdelivery    Boolean        @default(false)
  servicedelivery   Boolean        @default(false)
  order             myorder[]
  farmer            farmer         @relation(fields: [farmerid], references: [id], map: "Product_farmerid_fkey")
  review            review[]

  @@index([farmerid], map: "Product_farmerid_fkey")
}

model review {
  id        String        @id @default(uuid())
  userId    String
  rating    review_rating
  comment   String
  productid String
  product   product       @relation(fields: [productid], references: [id], map: "Review_productid_fkey")

  @@index([productid], map: "Review_productid_fkey")
}

model supplier {
  firstname String
  lastname  String
  email     String  @unique(map: "Supplier_email_key")
  password  String
  phone     String  @db.VarChar(20)
  isactive  Boolean @default(true)
  id        String  @id @default(uuid())
}

model user {
  firstname String
  isactive  Boolean       @default(true)
  email     String        @id
  usertype  user_usertype
  id        String        @unique(map: "User_id_key")
  order     myorder[]
}

model worker {
  id        String  @id @default(uuid())
  firstname String
  lastname  String
  email     String  @unique(map: "Worker_email_key")
  password  String
  isactive  Boolean @default(true)
}

enum order_customertype {
  BUYER
  SUPPLIER
}

enum review_rating {
  ONE
  TWO
  THREE
  FOUR
  FIVE
  SIX
  SEVEN
  EIGHT
  NINE
  TEN
}

enum product_type {
  CEREAL
  FRUIT
  VEGETABLE
  LEGUME
  TUBER
  HERB
  SPICE
  NUT_AND_SEED
  DAIRY
  LIVESTOCK
  POULTRY
  AQUACULTURE
  HONEY_AND_BEE
  FLOWER_AND_ORNAMENTAL
  ANIMAL_FEED
  AGROCHEMICAL
  FARM_TOOL_EQUIPMENT
  PROCESSED_FOOD
  BEVERAGE_CROP
  FIBER_CROP
  OTHER
}

enum user_usertype {
  buyer
  supplier
  farmer
  admin
  worker
}

enum product_unit {
  KG
  LITERS
  BAGS
  CRATES
  BUNCHES
  PIECES
  ANIMALS
  PACKETS
  TOOLS
  OTHER
}

enum order_deliveryoption {
  FARMER
  SELF
  SERVICE
}

enum product_status {
  AVAILABLE
  SOLD
  PENDING
  EXPIRED
  RESERVED
}

enum order_tracking {
  DELIVERED
  ENROUTE
  PACKING
  PACKED
}
